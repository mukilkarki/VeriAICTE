SECRET_KEY=replace-with-a-long-random-secret
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional for local development; use Application Default Credentials when available.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# Create a Turnstile widget in the Cloudflare dashboard and set both keys.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Optional: bootstrap this Firebase Authentication account as an administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=VeriAICTE
